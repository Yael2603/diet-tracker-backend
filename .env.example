# העתיקו את הקובץ הזה לקובץ בשם .env ומלאו ערכים אמיתיים.
# לעולם אל תעלו את קובץ .env ל-GitHub!

# כתובת מסד הנתונים PostgreSQL
# מקומי לדוגמה: postgresql://postgres:postgres@localhost:5432/diet_dev?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# מפתח סודי לחתימת ה-JWT - מחרוזת אקראית ארוכה (לפחות 32 תווים)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# תוקף ה-Token (למשל 1d = יום, 12h = 12 שעות)
JWT_EXPIRES_IN="1d"

# כתובות ה-React שמורשות לפנות לשרת, מופרדות בפסיק
CORS_ORIGIN="http://localhost:5173"

# פורט מקומי (בענן הפורט נקבע אוטומטית)
PORT=3000

# development / production
NODE_ENV="development"

# אזור הזמן לחישוב "היום"
APP_TIMEZONE="Asia/Jerusalem"

# ---- נתוני התחלה בענן (אופציונלי) ----
# true = בכל עליית שרת יוכנסו מאכלים/מסלולים/תפריטים (בלי לדרוס קיימים)
SEED_ON_START="false"
# חשבון הדיאטן שייווצר בפרודקשן (סיסמה של 10 תווים לפחות)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# משתמש לדוגמה עם נתונים (אופציונלי)
SEED_DEMO_USER_EMAIL=""
SEED_DEMO_USER_PASSWORD=""
